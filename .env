# ForensiWipe Environment Configuration
# Copy this file to .env and adjust for your environment.
# NEVER commit .env to version control.

# ─── SAFETY ──────────────────────────────────────────────────────────────────
# Safe mode is the default and MUST remain true for demos and development.
# When true, only loopback image targets are permitted for destructive operations.
SAFE_MODE=true

# Physical erasure is disabled by default.
# Both SAFE_MODE=false AND ALLOW_PHYSICAL_ERASE=true are required to reach physical devices.
ALLOW_PHYSICAL_ERASE=false

# Absolute path to the directory that is allowed to contain approved demo images.
# Only loopback devices backed by .img files inside this directory are allowed in safe mode.
 SAFE_DEMO_DIR=/home/aditya/forensiwipe/demo

# ─── APPLICATION ─────────────────────────────────────────────────────────────
APP_NAME=ForensiWipe
APP_VERSION=1.0.0-phase1
DEBUG=false

# Operator identifier written into every audit record.
OPERATOR_ID=forensiwipe-operator

# ─── DATABASE ────────────────────────────────────────────────────────────────
# SQLite database path for the audit log.
AUDIT_DB_PATH=/home/aditya/forensiwipe/forensiwipe_audit.db

# ─── PATHS ───────────────────────────────────────────────────────────────────
# Where recovered carving output is written (Module 3).
RECOVERED_DIR=/home/aditya/forensiwipe/recovered

# Where generated reports are written.
REPORTS_DIR=/home/aditya/forensiwipe/reports_output

# ─── BACKEND SERVER ──────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend origin — adjust if running on a different port.
FRONTEND_ORIGIN=http://localhost:5173
